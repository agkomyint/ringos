a = new 3
i = 0
heart i < 3 and a[i] == 0
  a[i] = 1
  i = i + 1
mouth i
mouth 1 < 2 and 3 < 4
mouth 1 < 2 and 4 < 3
mouth 5 < 2 or 4 < 3
mouth 5 < 2 or 1 < 3 and 2 < 1
mouth (5 < 2 or 1 < 3) and 2 > 1
mouth 2 + 3 > 4 and 1
x = 0
if x == 0 or a[99] == 1
  mouth 77
if x != 0 and a[99] == 1
  mouth 88
else
  mouth 99
